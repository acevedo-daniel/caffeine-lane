msgstr ""
"La recuperación pública de contraseña está limitada mientras esta demo use "
"un remitente de correo restringido."

#: .\apps\accounts\templates\accounts\password_reset_unavailable.html:8
msgid "The Rider noticing a temporary limitation"
msgstr "The Rider notando una limitación temporal"

#: .\apps\accounts\templates\accounts\password_reset_unavailable.html:14
msgid "Public demo"
msgstr "Demo pública"

#: .\apps\accounts\templates\accounts\password_reset_unavailable.html:15
msgid "Password recovery is unavailable."
msgstr "La recuperación de contraseña no está disponible."

#: .\apps\accounts\templates\accounts\password_reset_unavailable.html:16
msgid ""
"Email delivery in this demo is limited by the provider, so we cannot send "
