# Translations
*.mo
*.pot
!locale/**/LC_MESSAGES/django.mo

# Django specific
*.log
local_settings.py

# Keep migrations; ignore only their Python cache.
migrations/**/__pycache__/

# Local database files.
db.sqlite3
db.sqlite3-journal

# =========================
# Static & Media
# =========================

# Keep authored static assets; ignore collectstatic output and local uploads.
staticfiles/
media/

