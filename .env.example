DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-locally
DEBUG=true
DATABASE_URL=postgresql://caffeine-lane:caffeine-lane@localhost:5432/caffeine-lane
DIRECT_DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
CLOUDINARY_URL=
DEFAULT_FROM_EMAIL=noreply@example.com
CONTACT_RECIPIENT_EMAIL=owner@example.com
RESEND_API_KEY=
PASSWORD_RESET_ENABLED=false
RUN_MIGRATIONS_ON_START=true
SEED_PORTFOLIO_ON_START=false
CONTACT_RATE_LIMIT=5
CONTACT_RATE_LIMIT_WINDOW=3600
USE_X_FORWARDED_PROTO=false
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
CSP_ENFORCE=false
