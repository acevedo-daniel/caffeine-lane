{
  "name": "caffeine-lane-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-assets.mjs",
    "dev:css": "pnpm exec tailwindcss -i ./static/src/css/app.css -o ./static/dist/css/app.css --watch",
    "dev:js": "node scripts/dev-assets.mjs --js-only",
    "build:css": "pnpm exec tailwindcss -i ./static/src/css/app.css -o ./static/dist/css/app.css --minify",
    "build:js": "node scripts/build-assets.mjs",
    "build": "pnpm run build:css && pnpm run build:js",
    "capture:docs": "playwright test --config=playwright.docs.config.mjs",
    "test": "node --test tests/frontend/*.test.mjs",
    "test:e2e": "node scripts/prepare-e2e.mjs && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "chokidar": "4.0.3",
    "tailwindcss": "^4.3.3"
  },
  "packageManager": "pnpm@10.18.3",
  "description": "Django editorial application with accounts, moderation, media management and PostgreSQL."
}
