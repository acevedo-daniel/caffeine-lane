DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-locally
# Local-only development option. It has no effect in test or production.
DEBUG_TOOLBAR_ENABLED=false

# Local development uses Compose PostgreSQL. SQLite is an intentional fallback
# when DATABASE_URL is omitted; see README.md.
DATABASE_URL=postgresql://caffeine-lane:caffeine-lane@localhost:5432/caffeine-lane
DIRECT_DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
PUBLIC_SITE_URL=

# Production-only provider credentials. Leave blank for local development.
CLOUDINARY_URL=
DEFAULT_FROM_EMAIL=noreply@example.com
CONTACT_RECIPIENT_EMAIL=owner@example.com
RESEND_API_KEY=
PASSWORD_RESET_ENABLED=false

# Docker startup controls. Schema changes and editorial data are explicit release
# operations; neither runs when a web container starts by default.
RUN_MIGRATIONS_ON_START=false
SEED_EDITORIAL_ON_START=false
CONTACT_RATE_LIMIT=5
CONTACT_RATE_LIMIT_WINDOW=3600
USE_X_FORWARDED_PROTO=false
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
CSP_ENFORCE=false
